# Reverse proxy con HTTPS automático (Let's Encrypt) para el deploy.
# sslip.io: DNS wildcard gratis — <ip-con-guiones>.sslip.io resuelve a la IP.
# Uso: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

ip-del-vps.sslip.io {
	reverse_proxy web:3000
}

api.ip-del-vps.sslip.io {
	reverse_proxy ai-service:8000
}
