# --- LLM providers (con UNA basta; la cadena salta los no configurados) ---
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos (defaults sensatos ya en código; override opcional)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GEMINI_VISION_MODEL=gemini-2.0-flash

# --- CORS (opcional; default http://localhost:3000 si se omite) ---
# CORS_ORIGINS=http://localhost:3000,https://tu-deploy.vercel.app

# --- Supabase (mismo proyecto que la web) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Servidor MCP (bonus 2) — normalmente van como env del cliente MCP; ---
# --- aquí solo si prefieres no pasarlas en el comando de registro ---
# POKEDEX_EMAIL=
# POKEDEX_PASSWORD=
